# ===========================================
# ScamShield Backend — Environment Variables
# ===========================================

# Server
PORT=5000

# PostgreSQL Database (Neon or any PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# Gemini AI API Key (Google AI Studio — free tier)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# External Threat Intelligence APIs (Optional)
# The system works without these — they enhance URL/domain detection accuracy
# ===========================================

# Google Safe Browsing API Key (free, no billing required)
# Get from: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API Key (free Community tier — 4 req/min, 500/day)
# Get from: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
